<Window x:Class="Verrou.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verrou" Width="1220" Height="740" MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterScreen" Style="{StaticResource BaseWindow}">
    <Window.Resources>
        <Style x:Key="TbIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
        </Style>
        <Style x:Key="TbText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ToolSep" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Margin" Value="8,6"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Barre d'outils : niveau 1 (Anthracite) -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="6,0,12,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" ClipToBounds="True">
                    <Button x:Name="BtnNewVault" Style="{StaticResource ToolbarButton}" Click="NewVault_Click" ToolTip="Créer un nouveau coffre">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource TbIcon}" Text="&#xE8F4;"/><TextBlock Style="{StaticResource TbText}" Text="Nouveau"/></StackPanel>
                    </Button>
                    <Button x:Name="BtnOpen" Style="{StaticResource ToolbarButton}" Click="OpenVault_Click" ToolTip="Ouvrir un coffre (Ctrl+O)">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource TbIcon}" Text="&#xE838;"/><TextBlock Style="{StaticResource TbText}" Text="Ouvrir"/></StackPanel>
                    </Button>
                    <Button x:Name="BtnLock" Style="{StaticResource ToolbarButton}" Click="Lock_Click" ToolTip="Verrouiller (Ctrl+L)">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource TbIcon}" Text="&#xE72E;"/><TextBlock Style="{StaticResource TbText}" Text="Verrouiller"/></StackPanel>
                    </Button>
                    <Border Style="{StaticResource ToolSep}"/>
                    <Button x:Name="BtnAddEntry" Style="{StaticResource ToolbarButton}" Click="AddEntry_Click" ToolTip="Nouvelle entrée (Ctrl+N)">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource TbIcon}" Text="&#xE710;" Foreground="{DynamicResource AccentBrush}"/><TextBlock Style="{StaticResource TbText}" Text="Entrée"/></StackPanel>
                    </Button>
                    <Button x:Name="BtnAddGroup" Style="{StaticResource ToolbarButton}" Click="AddGroup_Click" ToolTip="Nouveau groupe dans le groupe sélectionné">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource TbIcon}" Text="&#xE8B7;"/><TextBlock Style="{StaticResource TbText}" Text="Groupe"/></StackPanel>
                    </Button>
                    <Button x:Name="BtnGenerator" Style="{StaticResource ToolbarButton}" Click="Generator_Click" ToolTip="Générateur de mots de passe (Ctrl+G)">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource TbIcon}" Text="&#xE8D7;"/><TextBlock Style="{StaticResource TbText}" Text="Générateur"/></StackPanel>
                    </Button>
                    <Border Style="{StaticResource ToolSep}"/>
                    <Button x:Name="BtnImport" Style="{StaticResource ToolbarButton}" Click="Import_Click" ToolTip="Importer (CSV, KeePass XML)" AutomationProperties.Name="Importer">
                        <TextBlock Style="{StaticResource TbIcon}" Text="&#xE8B5;" Margin="0"/>
                    </Button>
                    <Button x:Name="BtnExport" Style="{StaticResource ToolbarButton}" Click="Export_Click" ToolTip="Exporter une copie chiffrée" AutomationProperties.Name="Exporter">
                        <TextBlock Style="{StaticResource TbIcon}" Text="&#xEDE1;" Margin="0"/>
                    </Button>
                    <Button x:Name="BtnMore" Style="{StaticResource ToolbarButton}" Click="More_Click" ToolTip="Paramètres, sécurité du coffre">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource TbIcon}" Text="&#xE713;"/><TextBlock Style="{StaticResource TbText}" Text="Paramètres"/></StackPanel>
                    </Button>
                </StackPanel>
                <Border Grid.Column="2" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="10,0" Width="220" Height="36">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="8,0" MinHeight="0"
                                 TextChanged="SearchBox_TextChanged" ToolTip="Rechercher dans tout le coffre (Ctrl+F)"/>
                        <TextBlock x:Name="SearchHint" Grid.Column="1" Text="Rechercher (Ctrl+F)" Foreground="{DynamicResource MutedTextBrush}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Barre d'état -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ClipText" Grid.Column="1" Foreground="{DynamicResource CyanBrush}" FontSize="12" Margin="16,0" FontWeight="Medium"/>
                <TextBlock x:Name="InfoText" Grid.Column="2" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
            </Grid>
        </Border>

        <Grid>
            <!-- Coffre ouvert -->
            <Grid x:Name="VaultView" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" MinWidth="150"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*" MinWidth="300"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="340" MinWidth="260"/>
                </Grid.ColumnDefinitions>
                <TreeView x:Name="GroupTree" Padding="8,12" SelectedItemChanged="GroupTree_SelectedItemChanged"/>
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Margin="-2,0"/>
                <ListView x:Name="EntryList" Grid.Column="2" BorderThickness="0" SelectionMode="Extended"
                          SelectionChanged="EntryList_SelectionChanged" MouseDoubleClick="EntryList_MouseDoubleClick"
                          PreviewMouseLeftButtonDown="EntryList_PreviewMouseLeftButtonDown" PreviewMouseMove="EntryList_PreviewMouseMove">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Titre" Width="190" DisplayMemberBinding="{Binding Title}"/>
                            <GridViewColumn Header="Nom d'utilisateur" Width="180" DisplayMemberBinding="{Binding UserName}"/>
                            <GridViewColumn Header="URL" Width="170" DisplayMemberBinding="{Binding Url}"/>
                            <GridViewColumn x:Name="GroupColumn" Header="Groupe" Width="110" DisplayMemberBinding="{Binding GroupPath}"/>
                            <GridViewColumn Header="Modifié" Width="120" DisplayMemberBinding="{Binding ModifiedText}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock x:Name="EmptyListText" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"
                           TextAlignment="Center" LineHeight="20" IsHitTestVisible="False" Visibility="Collapsed"/>
                <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Margin="-2,0"/>
                <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" Background="{DynamicResource SurfaceBrush}">
                    <StackPanel x:Name="DetailsPanel" Margin="24,20"/>
                </ScrollViewer>
            </Grid>

            <!-- Écran verrouillé -->
            <Grid x:Name="LockView" Visibility="Collapsed">
                <Border Style="{StaticResource Card}" Width="460">
                    <StackPanel>
                        <Border Width="56" Height="56" CornerRadius="{StaticResource RadiusLarge}" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="26" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="LockTitle" Text="Coffre verrouillé" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,4"/>
                        <TextBlock x:Name="LockPath" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,24"/>

                        <StackPanel x:Name="PasswordRow">
                            <TextBlock Text="Mot de passe maître" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="MasterPwd" KeyDown="MasterPwd_KeyDown"/>
                            <TextBlock x:Name="CapsLockText" Text="Verr. Maj est activé" Foreground="{DynamicResource WarningBrush}" FontSize="12" Margin="0,4,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                        <Border x:Name="SecureHint" Background="{DynamicResource CyanSoftBrush}" BorderBrush="{DynamicResource CyanBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius}" Padding="14,10" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE83D;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource CyanBrush}" VerticalAlignment="Top" Margin="0,1,12,0"/>
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="13" LineHeight="19" Foreground="{DynamicResource TextBrush}"
                                           Text="Saisie protégée : le mot de passe et le code se tapent sur un bureau sécurisé, invisible des autres programmes (enregistreurs de frappe, captures d'écran)."/>
                            </Grid>
                        </Border>

                        <!-- Double authentification -->
                        <StackPanel x:Name="TwoFactorPanel" Visibility="Collapsed" Margin="0,16,0,0">
                            <StackPanel x:Name="CodeRow">
                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,6">
                                    <Run Text="&#xEA18;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentBrush}"/>
                                    <Run Text=" Code de double authentification"/>
                                </TextBlock>
                                <TextBox x:Name="CodeBox" FontFamily="{StaticResource MonoFont}" FontSize="18" MaxLength="7" KeyDown="MasterPwd_KeyDown"
                                         HorizontalContentAlignment="Center" ToolTip="Code à 6 chiffres de votre application d'authentification"/>
                            </StackPanel>
                            <StackPanel x:Name="RecoveryRow" Visibility="Collapsed">
                                <TextBlock x:Name="RecoveryHelp" Style="{StaticResource HelpText}" Margin="0,0,0,6"/>
                                <TextBlock Text="Clé de secours" Style="{StaticResource FieldLabel}" Margin="0,4,0,6"/>
                                <TextBox x:Name="RecoveryBox" FontFamily="{StaticResource MonoFont}" KeyDown="MasterPwd_KeyDown" ToolTip="Les 32 caractères notés lors de l'activation (espaces facultatifs)"/>
                            </StackPanel>
                            <Button x:Name="RecoveryLink" Style="{StaticResource LinkButton}" Content="Téléphone perdu ? Utiliser la clé de secours" Margin="0,8,0,0" FontSize="12" Click="RecoveryLink_Click"/>
                        </StackPanel>

                        <CheckBox x:Name="LockUseKeyFile" Content="Fichier-clé" Margin="0,16,0,6" Checked="LockUseKeyFile_Changed" Unchecked="LockUseKeyFile_Changed"/>
                        <Grid x:Name="LockKeyFileRow" IsEnabled="False">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="LockKeyFile"/>
                            <Button Grid.Column="1" Content="Choisir…" Margin="8,0,0,0" Click="LockBrowseKeyFile_Click"/>
                        </Grid>
                        <Border x:Name="UnlockErrorBox" Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius}" Padding="12,8" Margin="0,16,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="UnlockError" Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap" FontSize="13"/>
                        </Border>
                        <Button x:Name="UnlockButton" Content="Déverrouiller" Style="{StaticResource PrimaryButton}" Margin="0,20,0,0" Padding="12,10" Click="Unlock_Click"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Button Style="{StaticResource LinkButton}" Content="Ouvrir un autre coffre…" FontSize="12" Click="OpenVault_Click"/>
                            <TextBlock Text="   ·   " Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
                            <Button Style="{StaticResource LinkButton}" Content="Créer un coffre…" FontSize="12" Click="NewVault_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Premier lancement -->
            <Grid x:Name="WelcomeView" Visibility="Collapsed">
                <Border Style="{StaticResource Card}" Width="500">
                    <StackPanel>
                        <Image x:Name="WelcomeLogo" Width="72" Height="72" HorizontalAlignment="Center"/>
                        <TextBlock Text="Bienvenue dans Verrou" Style="{StaticResource TitleText}" HorizontalAlignment="Center" Margin="0,16,0,8"/>
                        <TextBlock Style="{StaticResource HelpText}" FontSize="14" LineHeight="20" TextAlignment="Center" Margin="0,0,0,24"
                                   Text="Vos mots de passe dans un fichier chiffré, sur votre PC uniquement, protégé par votre mot de passe maître et la double authentification."/>
                        <Button Style="{StaticResource PrimaryButton}" Padding="12,10" Margin="0,0,0,8" Click="NewVault_Click" AutomationProperties.Name="Créer un nouveau coffre">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Créer un nouveau coffre"/></StackPanel>
                        </Button>
                        <Button Padding="12,10" Margin="0" Click="OpenVault_Click" AutomationProperties.Name="Ouvrir un coffre existant">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Ouvrir un coffre existant…"/></StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
