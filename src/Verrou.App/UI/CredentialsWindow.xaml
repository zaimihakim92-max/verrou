<Window x:Class="Verrou.UI.CredentialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Verrou.UI"
        Title="Nouveau coffre" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource BaseWindow}" Background="{DynamicResource SurfaceBrush}">
    <StackPanel Margin="28,24,28,20">
        <TextBlock x:Name="Heading" Text="Créer un nouveau coffre" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="Intro" Style="{StaticResource HelpText}" FontSize="13" LineHeight="20" Margin="0,8,0,4"
                   Text="Le coffre est un fichier chiffré (AES-256-GCM, clé dérivée par Argon2id). Sans le mot de passe maître, le téléphone de double authentification (ou la clé de secours) et le fichier-clé s'il est utilisé, personne ne peut l'ouvrir — vous non plus."/>

        <Grid x:Name="NameRow" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="148"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock Text="Nom du coffre" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="VaultName" Grid.Column="1" Text="Mon coffre"/>
        </Grid>

        <Grid x:Name="PathRow" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="148"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Fichier" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="PathBox" Grid.Column="1"/>
            <Button Grid.Column="2" Content="Parcourir…" Margin="8,0,0,0" Click="BrowsePath_Click"/>
        </Grid>

        <TextBlock Text="Mot de passe maître" Style="{StaticResource SectionTitle}" Margin="0,20,0,8"/>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="148"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock Text="Mot de passe" Style="{StaticResource FieldLabel}"/>
            <ui:SecretBox x:Name="Pwd1" Grid.Column="1"/>
            <TextBlock Grid.Row="1" Text="Confirmation" Style="{StaticResource FieldLabel}" Margin="0,8,12,0"/>
            <ui:SecretBox x:Name="Pwd2" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"/>
            <ui:StrengthMeter x:Name="Strength" Grid.Row="2" Grid.Column="1" Margin="0,10,0,0"/>
        </Grid>

        <!-- Double authentification -->
        <StackPanel x:Name="TwoFactorSection">
            <TextBlock Text="Double authentification" Style="{StaticResource SectionTitle}" Margin="0,20,0,8"/>
            <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xEA18;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,2,14,0"/>
                    <StackPanel Grid.Column="1">
                        <Grid x:Name="TwoFactorBadgeRow" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Code à 6 chiffres du téléphone" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"
                                        ToolTip="Exigée pour tout nouveau coffre. Désactivable ensuite dans Paramètres › Mot de passe maître et double authentification.">
                                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Toujours activée" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="UseTwoFactor" Style="{StaticResource Switch}" IsChecked="True" Margin="0">
                            <TextBlock x:Name="TwoFactorTitle" Text="Code à 6 chiffres du téléphone" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </CheckBox>
                        <TextBlock x:Name="TwoFactorHelp" Style="{StaticResource HelpText}" Margin="0,4,0,0"
                                   Text="À l'étape suivante, vous scannerez un QR code avec une application d'authentification (Google Authenticator, Microsoft Authenticator, Aegis…) et noterez une clé de secours."/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <TextBlock Text="Fichier-clé (facultatif)" Style="{StaticResource SectionTitle}" Margin="0,20,0,8"/>
        <CheckBox x:Name="UseKeyFile" Style="{StaticResource Switch}" Margin="0,0,0,8" Checked="UseKeyFile_Changed" Unchecked="UseKeyFile_Changed">
            <TextBlock TextWrapping="Wrap" Text="Exiger aussi un fichier-clé"/>
        </CheckBox>
        <Grid x:Name="KeyFileRow" IsEnabled="False">
            <Grid.ColumnDefinitions><ColumnDefinition Width="148"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Fichier-clé" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="KeyFilePath" Grid.Column="1"/>
            <Button Grid.Column="2" Content="Choisir…" Margin="8,0,0,0" Click="BrowseKeyFile_Click"/>
            <Button Grid.Column="3" Content="Créer…" Margin="4,0,0,0" Click="CreateKeyFile_Click" ToolTip="Génère un fichier de 64 octets aléatoires"/>
        </Grid>
        <TextBlock x:Name="KeyFileHelp" Style="{StaticResource HelpText}" Margin="148,4,0,0"
                   Text="N'importe quel fichier qui ne change jamais. Gardez-en une copie (clé USB) : perdu ou modifié, le coffre devient irrécupérable."/>

        <TextBlock Text="Résistance aux attaques" Style="{StaticResource SectionTitle}" Margin="0,20,0,8"/>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="148"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Argon2id" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="KdfPreset" Grid.Column="1" SelectionChanged="KdfPreset_Changed">
                <ComboBoxItem Content="Standard — 64 Mio, 3 passes (≈ 0,5 s)"/>
                <ComboBoxItem Content="Renforcé — 256 Mio, 4 passes (≈ 2 s)"/>
                <ComboBoxItem Content="Personnalisé"/>
            </ComboBox>
            <Button Grid.Column="2" Content="Tester" Margin="8,0,0,0" Click="TestKdf_Click" ToolTip="Mesure le temps d'ouverture avec ces réglages"/>
        </Grid>
        <StackPanel x:Name="CustomKdf" Orientation="Horizontal" Margin="148,8,0,0" Visibility="Collapsed">
            <TextBlock Text="Mémoire (Mio)" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="KdfMem" Width="64" Text="64"/>
            <TextBlock Text="Passes" Style="{StaticResource FieldLabel}" Margin="16,0,12,0"/>
            <TextBox x:Name="KdfIt" Width="48" Text="3"/>
            <TextBlock Text="Fils" Style="{StaticResource FieldLabel}" Margin="16,0,12,0"/>
            <TextBox x:Name="KdfPar" Width="48" Text="4"/>
        </StackPanel>
        <TextBlock x:Name="KdfInfo" Style="{StaticResource HelpText}" Margin="148,4,0,0"/>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,-4,0">
            <TextBlock x:Name="BusyText" Text="Dérivation de la clé…" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource CyanBrush}" Visibility="Collapsed"/>
            <Button x:Name="OkButton" Content="Continuer" IsDefault="True" MinWidth="140" Style="{StaticResource PrimaryButton}" Click="Ok_Click"/>
            <Button Content="Annuler" IsCancel="True" MinWidth="96"/>
        </StackPanel>
    </StackPanel>
</Window>
